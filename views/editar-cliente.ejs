<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"><title>Editar Cliente</title></head>
<body>
    <h2>Editar Cliente</h2>
    <form action="/clientes/editar/<%= cliente.id %>" method="POST">
        <label>Nome Completo:</label><br>
        <input type="text" name="nome_completo" value="<%= cliente.nome_completo %>" required><br><br>

        <label>CPF:</label><br>
        <input type="text" name="cpf" value="<%= cliente.cpf %>" required><br><br>

        <label>E-mail:</label><br>
        <input type="email" name="email" value="<%= cliente.email %>"><br><br>

        <label>Telefone:</label><br>
        <input type="text" name="telefone" value="<%= cliente.telefone %>"><br><br>

        <label>Grupo de Atendimento:</label><br>
        <select name="grupo_id" required>
            <option value="">Selecione um grupo...</option>
            <% grupos.forEach(g => { %>
                <option value="<%= g.id %>" <%= g.id === cliente.grupo_id ? 'selected' : '' %>>
                    <%= g.nome %>
                </option>
            <% }) %>
        </select><br><br>

        <button type="submit">Salvar Alterações</button>
        <a href="/clientes">Cancelar</a>
    </form>
</body>
</html>